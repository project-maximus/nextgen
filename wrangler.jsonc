/**
 * Cloudflare Workers deployment (via @opennextjs/cloudflare).
 * Deploy with `npm run deploy`; preview the Workers build locally with `npm run preview`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextgen",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Production hostnames. Cloudflare creates the DNS records and certificates
  // for these itself — any existing A/CNAME on the same name must be deleted first.
  "routes": [
    { "pattern": "www.nextgenhealthinstitute.com", "custom_domain": true },
    { "pattern": "nextgenhealthinstitute.com", "custom_domain": true }
  ],
  // Keep the *.workers.dev address alive for checking deploys.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the worker call itself (used by OpenNext for caching/revalidation).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nextgen"
    }
  ],
  // next/image optimization through Cloudflare Images.
  "images": {
    "binding": "IMAGES"
  },
  // Lead-form submissions are logged with console.info — keep them searchable in the dashboard.
  "observability": {
    "enabled": true
  }
}
